{
  "environment": "test",
  "groups": [
    {"name": "pearland-paws-staff-admin"},
    {"name": "pearland-paws-staff-editor"},
    {"name": "pearland-paws-staff-reader"}
  ],
  "users": {{ authentik_staff_users | to_json }},
  "scope_mappings": [
    {"name": "Pearland Paws groups test", "scope_name": "groups", "expression": "return {'groups': [group.name for group in request.user.ak_groups.all()]}"},
    {"name": "Pearland Paws audience test", "scope_name": "audience", "expression": "return {'aud': request.provider.audience}"}
  ],
  "staff": {
    "issuer_host": "auth-test.{{ primary_domain }}",
    "provider_name": "pearland-paws-staff-test",
    "application_name": "Pearland Paws Staff Test",
    "application_slug": "pearland-paws-staff-test",
    "client_id": "pearland-paws-staff-test",
    "audience": "pearland-paws-staff-test",
    "secret_env": "STAFF_OIDC_CLIENT_SECRET",
    "scopes": ["groups", "audience"],
    "redirect_uris": ["https://staff-test.{{ primary_domain }}/api/staff/oidc/callback"],
    "logout_uris": ["https://staff-test.{{ primary_domain }}/staff/login"]
  },
  "netbird": {
    "issuer_host": "auth-test.{{ primary_domain }}",
    "provider_name": "netbird-test",
    "application_name": "NetBird Test",
    "application_slug": "netbird-test",
    "client_id": "netbird-test",
    "audience": "netbird-test",
    "secret_env": "NETBIRD_OIDC_CLIENT_SECRET",
    "scopes": ["groups", "audience"],
    "redirect_uris": ["https://netbird-test.{{ primary_domain }}/nb-auth", "https://netbird-test.{{ primary_domain }}/nb-silent-auth", "http://localhost:53000/"],
    "logout_uris": ["https://netbird-test.{{ primary_domain }}/nb-auth"]
  }
}
