# Authentik {{ authentik_environment }} ingress. Mounted into the existing app Nginx.
map $http_upgrade $authentik_connection_upgrade {
    default upgrade;
    '' close;
}
server {
    listen 80;
    server_name {{ authentik_domain }};
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    http2 on;
    server_name {{ authentik_domain }};
    ssl_certificate /etc/letsencrypt/live/{{ authentik_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ authentik_domain }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_header_timeout 1d;
    client_body_timeout 1d;
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $authentik_upstream authentik-server-{{ authentik_environment }}:9000;

    # OIDC discovery, authorization, JWKS, callbacks, logout, and WebSockets
    # remain reachable through the documented HTTPS issuer.
    location / {
        proxy_pass http://$authentik_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $authentik_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 1d;
        proxy_send_timeout 1d;
    }

    # Administrative UI and API are private to the NetBird management subnet.
    location ^~ /if/admin/ {
        allow {{ netbird_subnet }};
        deny all;
        proxy_pass http://$authentik_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
    }
    location ^~ /api/v3/ {
        allow {{ netbird_subnet }};
        deny all;
        proxy_pass http://$authentik_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
    }
}
