{
  "environment": {{ authentik_environment | to_json }},
  "groups": [{% for group in authentik_decrypted.IDENTITY_NAMES.role_groups.values() %}{"name": {{ group | to_json }}}{{ ',' if not loop.last else '' }}{% endfor %}],
  "users": {{ authentik_staff_users | to_json }},
  "branding": {
    "enabled": {{ authentik_branding_enabled | default(false) | bool | to_json }},
    "domain": {{ authentik_identity_profiles[authentik_environment].issuer_host | to_json }}{% if authentik_branding_enabled | default(false) | bool %},
    "css": {{ lookup('ansible.builtin.file', role_path ~ '/files/branding/login-v3.css') | to_json }}{% endif %}
  },
{% if authentik_google_enabled | default(false) %}
  "google": {
    "client_id": {{ authentik_decrypted.GOOGLE_OAUTH_CLIENT_ID | to_json }},
    "allowed_emails": {{ authentik_decrypted.GOOGLE_ALLOWED_EMAILS | to_json }}
  },
{% endif %}
  "scope_mappings": [
    {"name": {{ authentik_decrypted.IDENTITY_NAMES.scope_mapping_names.profile | to_json }}, "scope_name": "profile", "expression": "return {'name': user.name, 'preferred_username': user.username}"},
    {"name": {{ authentik_decrypted.IDENTITY_NAMES.scope_mapping_names.groups | to_json }}, "scope_name": "groups", "expression": {{ ("return {'groups': [group.name for group in user.ak_groups.all() if group.name in " ~ (authentik_decrypted.IDENTITY_NAMES.role_groups.values() | list | to_json) ~ "]}") | to_json }}},
    {"name": {{ authentik_decrypted.IDENTITY_NAMES.scope_mapping_names.audience | to_json }}, "scope_name": "audience", "expression": "return {'aud': provider.client_id}"}
  ],
{% for name in ['staff', 'netbird'] %}
{% set public_client = authentik_identity_profiles[authentik_environment][name] %}
{% set client = authentik_decrypted.IDENTITY_NAMES.staff if name == 'staff' else public_client %}
  "{{ name }}": {
    "issuer_host": {{ authentik_identity_profiles[authentik_environment].issuer_host | to_json }},
    "provider_name": {{ client.client_id | to_json }},
    "application_name": {{ client.application_name | to_json }},
    "application_slug": {{ client.client_id | to_json }},
    "client_id": {{ client.client_id | to_json }},
    "audience": {{ client.client_id | to_json }},
    "secret_env": "{{ name | upper }}_OIDC_CLIENT_SECRET",
    "scopes": ["profile", "groups", "audience"],
    "redirect_uris": {{ public_client.redirect_uris | to_json }},
    "logout_uris": {{ public_client.logout_uris | to_json }}
  }{{ ',' if not loop.last else '' }}
{% endfor %}
}
