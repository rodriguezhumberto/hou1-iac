name: {{ authentik_compose_project }}

services:
  postgresql:
    image: {{ authentik_postgres_image }}
    restart: unless-stopped
    env_file: [./authentik.env]
    environment:
      POSTGRES_DB: authentik
      POSTGRES_USER: authentik
      POSTGRES_PASSWORD: $${AUTHENTIK_POSTGRESQL__PASSWORD}
    volumes:
      - {{ authentik_data_root }}/postgres:/var/lib/postgresql/data
    networks: [backend]
    healthcheck:
      test: [CMD-SHELL, 'pg_isready -U authentik -d authentik']
      interval: 10s
      timeout: 5s
      retries: 12
      start_period: 20s
    mem_limit: {{ authentik_postgres_memory }}
    cpus: '{{ authentik_postgres_cpus }}'
    pids_limit: {{ authentik_postgres_pids }}
    logging: &bounded-logs
      driver: json-file
      options: {max-size: "20m", max-file: "3"}

  authentik-server:
    image: {{ authentik_image }}
    restart: unless-stopped
    command: server
    env_file: [./authentik.env]
    depends_on:
      postgresql:
        condition: service_healthy
        restart: true
    volumes:
      - {{ authentik_data_root }}/media:/media
      - {{ authentik_data_root }}/templates:/templates
      - {{ authentik_data_root }}/certs:/certs
      - {{ authentik_data_root }}/config:/blueprints
    networks:
      backend: {}
      ingress:
        aliases: [authentik-server-{{ authentik_environment }}]
    expose: ['9000']
    healthcheck:
      test: [CMD-SHELL, 'wget -q -O- http://127.0.0.1:9000/-/health/live/']
      interval: 15s
      timeout: 5s
      retries: 10
      start_period: 30s
    mem_limit: {{ authentik_server_memory }}
    cpus: '{{ authentik_server_cpus }}'
    pids_limit: {{ authentik_server_pids }}
    logging: *bounded-logs

  authentik-worker:
    image: {{ authentik_image }}
    restart: unless-stopped
    command: worker
    env_file: [./authentik.env]
    depends_on:
      postgresql:
        condition: service_healthy
        restart: true
    volumes:
      - {{ authentik_data_root }}/media:/media
      - {{ authentik_data_root }}/templates:/templates
      - {{ authentik_data_root }}/certs:/certs
      - {{ authentik_data_root }}/config:/blueprints
    networks: [backend]
    mem_limit: {{ authentik_worker_memory }}
    cpus: '{{ authentik_worker_cpus }}'
    pids_limit: {{ authentik_worker_pids }}
    logging: *bounded-logs

networks:
  backend:
    name: {{ authentik_compose_project }}-backend
    internal: true
  ingress:
    name: {{ authentik_ingress_network }}
    external: true
