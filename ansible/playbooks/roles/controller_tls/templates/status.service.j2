[Unit]
Description=Publish bounded HOU1 controller renewal status over the VPN
[Service]
Type=oneshot
{% if hou1_tls_executor_job_prefix | default('') %}
ExecStart=/usr/bin/sudo -n /usr/local/libexec/controller-renewal-exec {{ hou1_tls_executor_job_prefix }}-status
{% else %}
ExecStart={{ ansible_playbook_python }} {{ hou1_tls_schedule_directory }}/controller-tls.py --config {{ hou1_tls_controller_config }} --publish-status
{% endif %}
TimeoutStartSec=90
UMask=0077
NoNewPrivileges={{ 'no' if hou1_tls_executor_job_prefix | default('') else 'yes' }}
