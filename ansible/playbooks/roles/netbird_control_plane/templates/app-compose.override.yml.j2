services:
  nginx:
    volumes:
      - {{ netbird_control_plane_directory }}/nginx-include.conf:/etc/nginx/conf.d/netbird.conf:ro
      - {{ netbird_control_plane_directory }}/ingress:/etc/nginx/netbird:ro
    networks:
      app-network: {}
      netbird-ingress:
        ipv4_address: {{ netbird_ingress_proxy_ip }}
networks:
  netbird-ingress:
    external: true
    name: {{ netbird_ingress_network }}
