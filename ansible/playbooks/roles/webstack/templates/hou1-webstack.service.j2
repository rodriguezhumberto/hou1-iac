[Unit]
Description=HOU1 application startup after VPN address readiness
Requires=docker.service
Wants=netbird.service
After=docker.service netbird.service network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=true
ExecStart=/usr/local/libexec/hou1-compose-apply {{ app_directory | to_json | replace('%', '%%') | replace('$', '$$') }} --validate-nginx --require-address {{ netbird_ip | to_json }} --interface {{ netbird_interface | to_json | replace('%', '%%') | replace('$', '$$') }}
TimeoutStartSec=900
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
