services:
  # The replacement app owns CMS data.  Keeping the bind mount outside the
  # checkout makes deploys and git checkouts unable to replace content.
  # The existing Directus service is intentionally not mentioned here: its
  # legacy relative mounts remain active during the transition, and this
  # override therefore cannot resurrect Directus after a later app release
  # removes that service.
  astro-app:
    volumes:
      - "{{ cms_data_directory }}:/var/data"
