# Network Setup
HOU1_VPN_IP={{ netbird_ip }}
vpn_subnet={{ netbird_subnet }}
staff_vpn_subnet={{ staff_vpn_subnet }}


# Nginx Environment Mappings
PRIMARY_CERT_DIR={{ ssl_domains | selectattr('name', 'search', primary_domain) | map(attribute='name') | first | default('test.' ~ primary_domain) }}
SECONDARY_CERT_DIR={{ (ssl_domains | selectattr('name', 'search', secondary_domain) | map(attribute='name') | first | default('test.' ~ primary_domain)) if webstack_secondary_site_enabled | default(true) else '' }}
STAFF_HOSTNAME={{ staff_domain }}
STAFF_CERT_DIR={{ staff_cert_dir }}
PRIMARY_HOSTNAMES={{ public_site_hostnames | default([primary_domain, 'www.' ~ primary_domain, 'test.' ~ primary_domain]) | join(' ') }}
SECONDARY_HOSTNAMES={{ (secondary_site_hostnames | default([secondary_domain, 'www.' ~ secondary_domain, 'test.' ~ secondary_domain]) | join(' ')) if webstack_secondary_site_enabled | default(true) else '' }}
PUBLIC_CANONICAL_HOSTNAME={{ public_site_origin | urlsplit('hostname') }}
PUBLIC_CANONICAL_REDIRECT={{ (webstack_public_canonical_redirect | default(false)) | ternary('true', 'false') }}
PUBLIC_SITE_ORIGIN={{ public_site_origin }}

# for hCaptcha
PUBLIC_HCAPTCHA_SITE_KEY={{ public_hcaptcha_site_key }}
HCAPTCHA_SECRET_KEY={{ hcaptcha_secret_key }}

# Web Push
PUBLIC_VAPID_PUBLIC_KEY={{ VAPID_PUBLIC_KEY }}
VAPID_PUBLIC_KEY={{ VAPID_PUBLIC_KEY }}
VAPID_PRIVATE_KEY={{ VAPID_PRIVATE_KEY }}
VAPID_SUBJECT={{ VAPID_SUBJECT }}

# Staff app authentication
STAFF_ENVIRONMENT={{ 'production' if deploy_environment == 'prod' else 'test' }}
STAFF_PASSWORD={{ STAFF_PASSWORD }}
STAFF_SESSION_SECRET={{ STAFF_SESSION_SECRET }}
{% if staff_oidc_issuer | default('') %}
STAFF_OIDC_ISSUER={{ staff_oidc_issuer }}
STAFF_OIDC_CLIENT_ID={{ staff_oidc_client_id }}
STAFF_OIDC_CLIENT_SECRET={{ staff_oidc_client_secret }}
STAFF_OIDC_REDIRECT_URI=https://{{ staff_domain }}/api/staff/oidc/callback
STAFF_OIDC_POST_LOGOUT_REDIRECT_URI=https://{{ staff_domain }}/staff/login
STAFF_OIDC_SCOPES=openid profile email groups
{% endif %}

# Replacement CMS storage (test and production are host-isolated)
CMS_ENVIRONMENT={{ cms_environment }}
CMS_DATABASE_DIR=/var/data
CMS_MEDIA_DIR=/var/data/media
CMS_UPLOAD_MAX_BYTES={{ cms_upload_max_bytes }}
